/////////////////////////////////////////////////////////////
// ZaraMoney data model
//
// READ BEFORE REGENERATING:
// - Entities marked "skipServer" (TransactionPin, UserSession, RefreshToken,
//   AccessBlock) are HAND-WRITTEN. They are listed here only so the JDL
//   documents the whole model. JHipster must never generate CRUD
//   resources, DTOs or services for them (they hold PIN/token hashes).
//   Their schema lives in the hand-written Liquibase changesets
//   (20261112000000_phase2_security.xml, 20261113000000_device_sessions.xml).
// - Fields added after the initial generation (BankAccount.accountType,
//   IdempotencyRecord.requestHash) were also added by hand-written
//   changesets. When regenerating an entity, run with --skip-db-changelog
//   (or discard the changelog diff): applied changelogs must never change.
/////////////////////////////////////////////////////////////

/////////////////////////////////////////////////////////////
// ENUMS
/////////////////////////////////////////////////////////////

enum TransactionType {
  DEPOSIT,
  WITHDRAWAL,
  TRANSFER,
  PAYMENT,
  REFUND,
  FEE,
  REVERSAL,
  BONUS
}

enum TransactionStatus {
  PENDING,
  COMPLETED,
  FAILED
}

enum FraudStatus {
  CLEAN,
  SUSPICIOUS,
  BLOCKED
}

enum Currency {
  USD,
  TND
}

enum AccountStatus {
  ACTIVE,
  SUSPENDED,
  CLOSED
}

enum EntryType {
  DEBIT,
  CREDIT
}

enum KycStatus {
  PENDING,
  VERIFIED,
  REJECTED
}

enum NotificationType {
  TRANSACTION_ALERT,
  SECURITY_ALERT,
  FRAUD_ALERT,
  SYSTEM,
  PROMOTION
}

enum NotificationChannel {
  EMAIL,
  SMS,
  PUSH
}

enum NotificationStatus {
  PENDING,
  SENT,
  FAILED
}

/** CUSTOMER: user wallet, balance >= 0 (DB check). SYSTEM: internal account (promo, fees...), no user, may go negative. */
enum BankAccountType {
  CUSTOMER,
  SYSTEM
}

/** DEVICE: app with device keys (signed requests, refresh tokens). ADMIN: no keys, 15 min, no refresh. LEGACY: old app, optional mode only. */
enum SessionType {
  DEVICE,
  ADMIN,
  LEGACY
}

/** USER: blockValue = user login. DEVICE: blockValue = device id. */
enum AccessBlockType {
  USER,
  DEVICE
}

/////////////////////////////////////////////////////////////
// ENTITIES
/////////////////////////////////////////////////////////////

entity UserDetailsAccount {
  phoneNumber String required
  facePicture String required
  idCardPicture String required
  country String required
  address String required
  isAgent Boolean required
  kycStatus KycStatus required
  expoPushToken String
}

entity BankAccount {
  accountNumber String required unique minlength(8) maxlength(16)
  balance BigDecimal required
  currency Currency required
  status AccountStatus required
  createdAt Instant required
  // hand-written changeset 20261112000000_phase2_security.xml (default CUSTOMER)
  accountType BankAccountType required
}

entity TransactionRecord {
  transactionType TransactionType required

  sendAmount BigDecimal required min(1.00)
  receiveAmount BigDecimal required min(1.00)

  exchangeRate BigDecimal required
  // hand-written changeset 20261115000000_transaction_fee_column.xml (fee paid by the sender, 0 when free)
  fee BigDecimal

  currencySendAmount Currency required
  currencyReceiveAmount Currency required

  transactionStatus TransactionStatus required
  transactionReference String required unique minlength(10) maxlength(64)

  description String maxlength(255)

  riskScore Integer required min(0) max(100)
  fraudStatus FraudStatus required

  createdAt Instant required
  updatedAt Instant
  transactionDate Instant required
}

entity LedgerEntry {
  amount BigDecimal required
  currency Currency required
  entryType EntryType required
  createdAt Instant required
}

entity TransactionFee {
  amount BigDecimal required
  currency Currency required
  type String required
}

entity TransactionLimit {
  dailyLimit BigDecimal
  monthlyLimit BigDecimal
}

entity IdempotencyRecord {
  keyHash String required unique maxlength(128)
  endpoint String required maxlength(200)
  userId Long required
  createdAt Instant required

  responseBody TextBlob
  responseStatus Integer
  transactionReference String maxlength(64)
  // hand-written changeset 20261112000000_phase2_security.xml
  // SHA-256 of the business fields of the request (never the PIN)
  requestHash String maxlength(64)
}

entity Notification {
  title String required maxlength(100)
  message String required maxlength(500)

  type NotificationType required
  channel NotificationChannel required
  status NotificationStatus required

  isRead Boolean required

  deepLink String maxlength(255)

  createdAt Instant required
  sentAt Instant

  data TextBlob
}

/////////////////////////////////////////////////////////////
// HAND-WRITTEN ENTITIES (skipServer: never generate CRUD for them)
/////////////////////////////////////////////////////////////

/** Transaction PIN (BCrypt), one per user. 5 wrong PINs -> locked 30 min. Never expose via DTO/CRUD. */
entity TransactionPin {
  pinHash String required maxlength(100)
  failedAttempts Integer required
  lockedUntil Instant
  updatedAt Instant required
}

/** One login = one session = one refresh-token family. Every access token references a session (sid). */
entity UserSession {
  sid String required unique maxlength(36)
  sessionType SessionType required
  deviceId String maxlength(64)
  deviceName String maxlength(100)
  platform String maxlength(20)
  devicePublicKey String maxlength(512)
  transactionPublicKey String maxlength(512)
  ip String maxlength(64)
  userAgent String maxlength(255)
  createdAt Instant required
  lastUsedAt Instant
  expiresAt Instant required
  revokedAt Instant
  revokeReason String maxlength(50)
}

/** Refresh token, stored as SHA-256 only. Rotated on every refresh (replacedById = next token). */
entity RefreshToken {
  tokenHash String required unique maxlength(64)
  createdAt Instant required
  expiresAt Instant required
  usedAt Instant
  replacedById Long
}

/** Blocked user (by login) or device (by device id). */
entity AccessBlock {
  blockType AccessBlockType required
  blockValue String required maxlength(100)
  reason String maxlength(255)
  createdBy String maxlength(100)
  createdAt Instant required
}

/////////////////////////////////////////////////////////////
// RELATIONSHIPS
/////////////////////////////////////////////////////////////

relationship ManyToOne {

  BankAccount{user(login)} to User with builtInEntity

  TransactionRecord{sender(accountNumber)} to BankAccount
  TransactionRecord{receiver(accountNumber)} to BankAccount

  LedgerEntry{account(accountNumber)} to BankAccount
  LedgerEntry{transaction(transactionReference)} to TransactionRecord

  TransactionFee{transaction(transactionReference)} to TransactionRecord

  Notification{user(login)} to User with builtInEntity

  Notification{transaction(transactionReference)} to TransactionRecord

  UserSession{user(login) required} to User with builtInEntity

  RefreshToken{session(sid) required} to UserSession
}

relationship OneToOne {

  UserDetailsAccount{user} to User with builtInEntity

  TransactionLimit{account(accountNumber)} to BankAccount

  TransactionPin{user(login) required} to User with builtInEntity
}

/////////////////////////////////////////////////////////////
// OPTIONS
/////////////////////////////////////////////////////////////

paginate * with pagination except TransactionPin, UserSession, RefreshToken, AccessBlock
dto * with mapstruct except User, TransactionPin, UserSession, RefreshToken, AccessBlock
service * with serviceClass except User, TransactionPin, UserSession, RefreshToken, AccessBlock
filter * except TransactionPin, UserSession, RefreshToken, AccessBlock

// Hand-written entities: no generated server code (no Resource/Service/DTO/changelog)
skipServer TransactionPin, UserSession, RefreshToken, AccessBlock
