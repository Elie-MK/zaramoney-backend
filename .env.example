# Copy to .env (git-ignored) for local dev, or use the same keys in the server's systemd EnvironmentFile for prod.
# Never commit real values.
# cp .env.exemple .env
# token secret generator : openssl rand -base64 64

# --- Required in prod ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/zaramoneybackend
SPRING_DATASOURCE_USERNAME=zaramoney
SPRING_DATASOURCE_PASSWORD=change-me
# Generate with: openssl rand -base64 64 | tr -d '\n'
JHIPSTER_SECURITY_AUTHENTICATION_JWT_BASE64_SECRET=change-me

# --- Cloudinary (KYC uploads) ---
CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me
